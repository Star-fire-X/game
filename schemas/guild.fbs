// guild.fbs
include "common.fbs";
namespace mir2.proto;

// Legacy guild message ids (1-10). Kept for compatibility during MsgId migration.
enum GuildMessageType : ubyte {
  CREATE = 1,
  JOIN = 2,
  LEAVE = 3,
  KICK = 4,
  DECLARE_WAR = 5,
  CANCEL_WAR = 6,
  MAKE_ALLY = 7,
  BREAK_ALLY = 8,
  UPDATE_NOTICE = 9,
  UPDATE_RANK = 10
}

table GuildRankInfo {
  rank: ubyte;
  rank_name: string;
  members: [string];
}

table GuildWarInfo {
  enemy_guild_id: uint;
  start_time: ulong;
  remain_time: ulong;
}

table GuildInfo {
  id: ulong;
  name: string;
  level: ushort;
  member_count: uint;
  leader_id: ulong;
  leader_name: string;
  max_members: uint;
  notice_list: [string];
  ranks: [GuildRankInfo];
  war_guilds: [GuildWarInfo];
  ally_guild_ids: [uint];
  allow_ally: bool;
  in_team_fight: bool;
  match_point: int;
  fight_members: [string];
}

table CreateGuildRequest {
  guild_name: string;
}

table CreateGuildResponse {
  success: bool;
  error_code: int;
  guild_info: GuildInfo;
}

table JoinGuildRequest {
  guild_id: uint;
}

table JoinGuildResponse {
  success: bool;
  error_code: int;
}

table LeaveGuildRequest {
}

table LeaveGuildResponse {
  success: bool;
  error_code: int;
}

table KickGuildRequest {
  target_character_id: uint;
}

table KickGuildResponse {
  success: bool;
  error_code: int;
}

table DeclareWarRequest {
  target_guild_id: uint;
}

table DeclareWarResponse {
  success: bool;
  error_code: int;
}

table CancelWarRequest {
  target_guild_id: uint;
}

table CancelWarResponse {
  success: bool;
  error_code: int;
}

table MakeAllianceRequest {
  target_guild_id: uint;
}

table MakeAllianceResponse {
  success: bool;
  error_code: int;
}

table BreakAllianceRequest {
  target_guild_id: uint;
}

table BreakAllianceResponse {
  success: bool;
  error_code: int;
}

table UpdateNoticeRequest {
  notice_lines: [string];
}

table UpdateNoticeResponse {
  success: bool;
  error_code: int;
}

table RankUpdateMember {
  character_id: uint;
  rank: ubyte;
}

table UpdateRankRequest {
  members: [RankUpdateMember];
}

table UpdateRankResponse {
  success: bool;
  error_code: int;
}

table GuildInfoSync {
  guild_info: GuildInfo;
}
